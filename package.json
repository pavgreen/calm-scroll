{
  "name": "phobia-safe-browsing",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Chrome extension (MV3) that blurs phobia-triggering images using on-device ML.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" vite.config.ts",
    "lint:fix": "eslint \"src/**/*.ts\" vite.config.ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons:placeholder": "node scripts/generate-placeholder-icons.mjs"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.2.9",
    "@types/node": "^26.5.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2"
  }
}
